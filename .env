# ============================================
# 🔥 AIRFLOW FRAMEWORK .ENV CONFIGURATION
# ============================================
# Environment variables for docker-compose.yml
# Customize these values for your environment

# ============================================
# 🔧 BASIC SETTINGS
# ============================================
ENVIRONMENT=development
DEBUG_MODE=true
COMPOSE_CONVERT_WINDOWS_PATHS=1

# Docker configuration
AIRFLOW_IMAGE_NAME=apache/airflow:3.0.4
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

# ============================================
# 🔐 SECURITY (CHANGE FOR PRODUCTION!)
# ============================================
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=framework_secret_key_change_in_production_123456789
AIRFLOW_WEBSERVER_SECRET_KEY=framework_webserver_secret_change_in_production

# Admin user
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# ============================================
# 🗄️ DATABASE CONFIGURATION
# ============================================
POSTGRES_VERSION=13
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_HOST_AUTH_METHOD=md5

# Development Database
POSTGRES_DEV_USER=postgres
POSTGRES_DEV_PASSWORD=postgres
POSTGRES_DEV_DB=test_database

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ============================================
# ⚡ PERFORMANCE CONFIGURATION
# ============================================
AIRFLOW_EXECUTOR=LocalExecutor
AIRFLOW_PARALLELISM=32
MAX_ACTIVE_RUNS_PER_DAG=16
MAX_ACTIVE_TASKS_PER_DAG=16
DEFAULT_TASK_RETRIES=2

# Timeouts (seconds)
TASK_TIMEOUT=1800
DAGRUN_TIMEOUT=3600
DAGBAG_IMPORT_TIMEOUT=180
WEBSERVER_WORKER_TIMEOUT=120

# Scheduler
SCHEDULER_PARSING_PROCESSES=2
MIN_FILE_PROCESS_INTERVAL=10
DAG_REFRESH_INTERVAL=30
DAG_DIR_LIST_INTERVAL=300
CATCHUP_BY_DEFAULT=false

# Webserver
WEBSERVER_WORKERS=4
WEBSERVER_AUTHENTICATE=true
EXPOSE_CONFIG=true

# ============================================
# 🎨 DAG CONFIGURATION
# ============================================
DAGS_PAUSED_AT_CREATION=false
LOAD_EXAMPLES=false
DAG_DISCOVERY_SAFE_MODE=false

# ============================================
# 📊 LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=INFO
COLORED_CONSOLE_LOG=true
REMOTE_LOGGING=false

# ============================================
# 📈 MONITORING CONFIGURATION
# ============================================
STATSD_ENABLED=true
STATSD_HOST=prometheus-statsd
STATSD_PORT=8125
STATSD_PREFIX=airflow

# Service URLs
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
STATSD_EXPORTER_URL=http://prometheus-statsd:9102

# ============================================
# 📊 GRAFANA CONFIGURATION
# ============================================
GRAFANA_VERSION=latest
GRAFANA_PORT=3000

# Grafana Security (CHANGE FOR PRODUCTION!)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_SECRET_KEY=SW2YcwTIb9zpOOhoPsMm

# Grafana Features
GRAFANA_ALLOW_SIGN_UP=false
GRAFANA_ANONYMOUS_ENABLED=true
GRAFANA_ANONYMOUS_ORG_ROLE=Viewer

# ============================================
# 🌐 WEBSERVER CONFIGURATION
# ============================================
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# ============================================
# 🔧 FRAMEWORK CONFIGURATION
# ============================================
FRAMEWORK_METADATA_PATH=/opt/airflow/metadata
FRAMEWORK_CONFIG_PATH=/opt/airflow/config
FRAMEWORK_SCRIPTS_PATH=/opt/airflow/scripts
FRAMEWORK_LOG_LEVEL=INFO
FRAMEWORK_ENABLE_METRICS=true
FRAMEWORK_AUTO_DISCOVER_CONNECTIONS=true

# ============================================
# 📦 ADDITIONAL PACKAGES
# ============================================
_PIP_ADDITIONAL_REQUIREMENTS=

# ============================================
# 🔌 EXTERNAL SERVICES (Optional)
# ============================================
# Uncomment and configure as needed:

# ClickHouse (for external ClickHouse connections)
# CLICKHOUSE_HOST=your-clickhouse-host.com
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=your_password

# MongoDB (for external MongoDB connections)  
# MONGODB_HOST=your-mongodb-host.com
# MONGODB_PORT=27017
# MONGODB_PASSWORD=your_password

# Notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# ============================================
# 🔍 DEVELOPMENT SETTINGS
# ============================================
DEV_MODE=true

# Optional timezone
# TZ=America/New_York
# Windows Configuration
AIRFLOW_UID=50000
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
COMPOSE_CONVERT_WINDOWS_PATHS=1
AIRFLOW_UID=50000


AIRFLOW__CORE__SECRET_KEY=pass1234

# Airflow Docker Image
AIRFLOW_IMAGE_NAME=apache/airflow:3.0.4

# User ID for Airflow containers (run 'id -u' on Linux to get your user ID)
AIRFLOW_UID=50000

# Base path for project files
AIRFLOW_PROJ_DIR=.

# Admin user credentials
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Additional PIP requirements (optional)
# Example: _PIP_ADDITIONAL_REQUIREMENTS=pandas==1.5.0 requests==2.28.0
_PIP_ADDITIONAL_REQUIREMENTS=

# Framework-specific configurations (your custom additions)
FRAMEWORK_METADATA_PATH=/opt/airflow/metadata

# Optional: Set timezone
# TZ=America/New_York

# Optional: Enable debug mode
# AIRFLOW__CORE__DEBUG=true

# Optional: Set log level
# AIRFLOW__LOGGING__LOGGING_LEVEL=INFO